{
  "name": "@bibit-internal/agent-hub-plugin",
  "version": "0.3.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:dev": "vite build",
    "typecheck": "tsc --noEmit",
    "keygen": "bibit-plugin keygen --out .bibit-keys --key-id agent-hub-development",
    "build:plugin": "bibit-plugin build --key .bibit-keys/agent-hub-development-private.pem --key-id agent-hub-development",
    "test": "vitest run"
  },
  "bibitPlugin": {
    "entry": "src/plugin.tsx",
    "manifest": "bibit.feature.json",
    "artifactDir": "artifacts"
  },
  "dependencies": {
    "@bibit/feature-contracts": "file:vendor/bibit-feature-contracts-0.4.0.tgz",
    "@bibit/feature-dev-host": "file:vendor/bibit-feature-dev-host-0.4.0.tgz",
    "@bibit/feature-plugin-sdk": "file:vendor/bibit-feature-plugin-sdk-0.4.0.tgz",
    "@bibit/feature-sdk": "file:vendor/bibit-feature-sdk-0.4.0.tgz",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  }
}
