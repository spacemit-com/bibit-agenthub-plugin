{
  "version": 2,
  "services": {
    "store": {
      "transport": "stdio",
      "executable": "/usr/libexec/bibit/bibit-agenthub",
      "args": ["provider"],
      "lifecycle": "managed",
      "protocolVersions": [1],
      "requestTimeoutMs": 300000,
      "credentialParameters": {
        "settings.keys.add.v1": ["apiKey"]
      }
    }
  }
}
