#!/usr/bin/make -f

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
SUPPORTED_ARCHS := amd64 arm64 riscv64

ifeq ($(filter $(DEB_HOST_ARCH),$(SUPPORTED_ARCHS)),)
$(error Unsupported DEB_HOST_ARCH "$(DEB_HOST_ARCH)"; supported: $(SUPPORTED_ARCHS))
endif

# Signing key for the frontend bundle. CI injects a GitLab File variable
# (AGENT_HUB_SIGNING_KEY) whose value is the private-key path; local builds
# fall back to the development key under .bibit-keys/.
AGENT_HUB_SIGNING_KEY ?= .bibit-keys/agent-hub-development-private.pem

# `node` used for both the version lookup and the bundle step. The bundle is a
# gzipped tar, so its bytes -- and the SHA-256 a release records -- come from the
# zlib the Node runtime ships. Node 18 carries zlib 1.3 and Node 24 carries
# 1.3.1, and no gzip level or strategy makes the two agree, so the runtime is
# pinned in .nvmrc and `scripts/check-node.mjs` fails the build rather than
# emitting a second, silently different bundle.
#
# Default resolution order: the interpreter nvm keeps for the pinned version,
# then a system-wide Node 24 install, then plain `node` (which the check will
# reject with instructions if it is the wrong version). Override explicitly with
#   NODE="$HOME/.nvm/versions/node/v24.16.0/bin/node" dpkg-buildpackage -us -uc -b
NODE_PIN := $(shell cat .nvmrc 2>/dev/null)
NODE_FROM_NVM := $(HOME)/.nvm/versions/node/v$(NODE_PIN)/bin/node
NODE ?= $(if $(wildcard $(NODE_FROM_NVM)),$(NODE_FROM_NVM),$(if $(wildcard /usr/local/bin/node),/usr/local/bin/node,node))
PLUGIN_VERSION := $(shell $(NODE) -p "require('./package.json').version")

# The pinned interpreter's own bin directory, so the `node`/`npm`/`npx` invoked
# below are the pinned ones instead of whatever the packaging shell happens to
# have on PATH. Without this the version check could pass while the bundle was
# still compressed by a different runtime.
NODE_BIN_DIR := $(patsubst %/,%,$(dir $(shell command -v $(NODE) 2>/dev/null)))
ifeq ($(NODE_BIN_DIR),)
$(error NODE="$(NODE)" was not found; point it at the interpreter .nvmrc pins)
endif
BUILD_PATH := $(NODE_BIN_DIR):$(PATH)

%:
	dh $@

override_dh_auto_build:
	test -f debian/agenthub-feature-grants.json
	test -f "$(AGENT_HUB_SIGNING_KEY)"
	$(MAKE) -C provider build GOARCH=$(DEB_HOST_ARCH)
	env PATH="$(BUILD_PATH)" npm ci
	$(NODE) scripts/check-node.mjs
	env PATH="$(BUILD_PATH)" npx bibit-plugin build --key "$(AGENT_HUB_SIGNING_KEY)" --key-id agent-hub-development
	cp artifacts/agent-hub-$(PLUGIN_VERSION).bibit-plugin.tgz debian/vendor/agent-hub.bibit-plugin.tgz

override_dh_auto_clean:
	$(MAKE) -C provider clean
	rm -f debian/vendor/agent-hub.bibit-plugin.tgz

override_dh_auto_install:
	install -Dm0644 \
	  debian/vendor/agent-hub.bibit-plugin.tgz \
	  debian/bibit-agenthub-plugin/usr/lib/bibit/plugins/agent-hub.bibit-plugin.tgz
	install -Dm0644 \
	  debian/agenthub-feature-grants.json \
	  debian/bibit-agenthub-plugin/etc/bibit/feature-capability-grants.d/agenthub.json
	install -Dm0755 \
	  artifacts/provider/$(DEB_HOST_ARCH)/bibit-agenthub \
	  debian/bibit-agenthub-cli/usr/libexec/bibit/bibit-agenthub
	install -Dm0644 \
	  debian/agenthub-provider.json \
	  debian/bibit-agenthub-cli/etc/bibit/external-services.d/agenthub.json

override_dh_strip:
	@# Pure Go binary is already stripped at build time (-ldflags="-s -w");
	@# skip dh_strip so a wrong-architecture strip is never invoked.
	@true

override_dh_makeshlibs:
	@# CGO_ENABLED=0 binary is fully static; skip shlibs scan so a
	@# wrong-architecture objdump is never invoked.
	@true

override_dh_shlibdeps:
	@# Static binary has no shared library dependencies to compute.
	@true
