{
  "manifestSchemaVersion": 1,
  "sdkApiVersion": 1,
  "id": "agent-hub",
  "version": "0.3.3",
  "owner": "agent-hub-team",
  "display": {
    "titleKey": "agent-hub:title",
    "fallbackTitle": "Agent Hub",
    "iconKey": "store",
    "descriptionKey": "agent-hub:description",
    "fallbackDescription": "Browse and manage Agent packages"
  },
  "targets": ["desktop"],
  "requiredHostCapabilities": ["service:store"],
  "contributions": {
    "pages": [
      { "id": "home", "path": "", "surfaces": ["main"], "navigation": { "group": "library", "order": 100 } }
    ],
    "settings": [
      {
        "id": "settings",
        "path": "",
        "surfaces": ["main"],
        "navigation": {
          "group": "integrations",
          "order": 100,
          "titleKey": "agent-hub:settings",
          "fallbackTitle": "Agent Hub settings"
        }
      }
    ],
    "conversation": [],
    "locales": ["en", "zh-CN"]
  }
}
